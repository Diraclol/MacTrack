<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MacTrack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Launch (splash) theme: MacTrack blue background with the white monogram centered, then hands
         off to Theme.MacTrack once Compose draws. Provided by androidx core-splashscreen (backported). -->
    <style name="Theme.MacTrack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mactrack_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MacTrack</item>
    </style>
</resources>